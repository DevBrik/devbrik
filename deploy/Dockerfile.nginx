FROM node:22 AS front
WORKDIR /f
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build -- --configuration production

FROM nginx:1.27-alpine
ARG NGINX_CONF=http.conf
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx/${NGINX_CONF} /etc/nginx/conf.d/default.conf
COPY deploy/nginx/proxy-commun.inc deploy/nginx/en-tetes.inc deploy/nginx/en-tetes-hsts.inc /etc/nginx/conf.d/
COPY --from=front /f/dist/ /tmp/dist/
RUN mkdir -p /usr/share/nginx/html && cp -r /tmp/dist/*/browser/. /usr/share/nginx/html/ && rm -rf /tmp/dist
EXPOSE 80 443