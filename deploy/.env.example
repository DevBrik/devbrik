# Copier en deploy/.env puis remplacer TOUTES les valeurs. Ne jamais versionner .env.
DB_NAME=devbrik
DB_USER=devbrik
DB_PASSWORD=CHANGER_MOI
# JWT : au moins 32 caracteres aleatoires (openssl rand -base64 48)
JWT_SECRET=CHANGER_MOI_32_CARACTERES_MINIMUM
# Pseudo valide (RG1) et non réservé : « admin » est refusé
ADMIN_PSEUDO=admin.demo
ADMIN_MOT_DE_PASSE=CHANGER_MOI
# Doit differer de ADMIN_MOT_DE_PASSE (S12)
DEMO_MOT_DE_PASSE=CHANGER_MOI_AUSSI
# http.conf (avant domaine) ou https.conf (apres certificat)
NGINX_CONF=http.conf